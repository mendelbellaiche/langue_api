# Test your FastAPI endpoints

GET http://127.0.0.1:8000/
Accept: application/json

###

GET http://127.0.0.1:8000/hello/User
Accept: application/json

###

GET http://127.0.0.1:8000/version
Accept: application/json

###

GET http://127.0.0.1:8000/languages
Accept: application/json

###

# Register a new user
POST http://127.0.0.1:8000/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "SuperSecret123!"
}

###

# Register the same user again -> should fail with 400
POST http://127.0.0.1:8000/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "SuperSecret123!"
}

###

# Register with a weak password -> should fail with 422
POST http://127.0.0.1:8000/register
Content-Type: application/json

{
  "email": "weak@example.com",
  "password": "weak"
}

###

# Login with correct credentials -> returns access_token
POST http://127.0.0.1:8000/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "SuperSecret123!"
}

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}

###

# Login with wrong password -> should fail with 401
POST http://127.0.0.1:8000/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "WrongPassword"
}

###

# Refresh the access token using the refresh token -> returns new tokens
POST http://127.0.0.1:8000/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}

###

# Logout -> revokes the refresh token
POST http://127.0.0.1:8000/logout
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

###

# Using a revoked refresh token again -> should fail with 401
POST http://127.0.0.1:8000/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

###

# Translate text using the token obtained from login
POST http://127.0.0.1:8000/translate
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "text": "Hello, how are you?",
  "source_lang": "en",
  "target_langs": ["fr", "es", "de"]
}

###

# Translate without a token -> should fail with 401/403
POST http://127.0.0.1:8000/translate
Content-Type: application/json

{
  "text": "Hello, how are you?",
  "source_lang": "en",
  "target_langs": ["fr"]
}

###

# Translate with an invalid target language code -> should fail with 400
POST http://127.0.0.1:8000/translate
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "text": "Hello, how are you?",
  "source_lang": "en",
  "target_langs": ["not-a-lang"]
}

###

# Get the current user's translation history (default pagination)
GET http://127.0.0.1:8000/translations
Accept: application/json
Authorization: Bearer {{access_token}}

###

# Get the current user's translation history (custom pagination)
GET http://127.0.0.1:8000/translations?limit=5&offset=0
Accept: application/json
Authorization: Bearer {{access_token}}

###
